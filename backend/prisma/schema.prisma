generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id          Int      @id @default(autoincrement())
  factoryName String   @unique
  type        String?
  createdAt   DateTime @default(now())
}

model Yarns {
  id       Int    @id @unique @default(autoincrement())
  yarnType String @unique
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  workOrderNo        String
  workOrderPlaceDate String
  month              String
  styleNo            String
  lotNo              String
  jobNo              String
  orderType          String
  compositions       Composition[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
  jobs               jobs?             @relation(fields: [jobId], references: [id])
  jobId              Int?
  yarnDyeingJobs     yarnDyeingJobs[]
  factoryName        String            @default("NULL")

  @@index([styleRequirementId])
  @@index([styleNo])
  @@index([jobId])
}

model yarnDyeingJobs {
  id          Int        @id @default(autoincrement())
  color       String
  qty         Float
  composition String
  createdAt   DateTime   @default(now())
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId Int?
  // yarnDeliveries yarnDeliveries[]
}

// model yarnDeliveries {
//   id Int @id @default(autoincrement())

//   yarnDyeingJobs   yarnDyeingJobs? @relation(fields: [yarnDyeingJobsId], references: [id])
//   yarnDyeingJobsId Int?
// }

model Composition {
  id                    Int                  @id @default(autoincrement())
  composition           String
  unitePrice            Float
  color                 String
  additional            Int                  @default(0)
  orderQty              Int
  workOrderQty          Float
  workOrder             WorkOrder            @relation(fields: [workOrderId], references: [id])
  workOrderId           Int
  deliveries            deliveries[]
  orderType             String               @default("null")
  styleRequirementRow   StyleRequirementRow? @relation(fields: [styleRequirementRowId], references: [id])
  styleRequirementRowId Int?
  challans              Challan[]

  @@index([workOrderId])
  @@index([color])
  @@index([styleRequirementRowId])
}

model StyleRequirement {
  id           Int                   @id @default(autoincrement())
  salesContact String
  buyerName    String
  jobNo        String                @unique
  poNo         String
  styleNo      String
  processLoss  Float
  rows         StyleRequirementRow[]
  sizes        sizes[]
  workOrders   WorkOrder[]
}

model StyleRequirementRow {
  id                 Int              @id @default(autoincrement())
  styleRequirementId Int
  styleRequirement   StyleRequirement @relation(fields: [styleRequirementId], references: [id])
  color              String
  composition        String
  finishDia          String
  orderQty           Int
  finishRequiredQty  Float
  additional         Int              @default(0)

  // NEW: back-relation so a row can see all Composition records derived from it
  compositions Composition[]

  @@index([styleRequirementId])
}

model sizeWiseCutting {
  id             Int   @id @default(autoincrement())
  cuttingStyleId Int
  sizeId         Int
  size           sizes @relation(fields: [sizeId], references: [id])
  cutQty         Int // ← was String

  @@index([sizeId])
  @@index([cuttingStyleId])
}

model sizes {
  id                 Int               @id @default(autoincrement())
  sizeName           String
  createdAt          DateTime          @default(now())
  sizeWiseCuttings   sizeWiseCutting[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?

  @@index([styleRequirementId])
}

// ── Universal Challan Model (works for ALL delivery types) ──
model Challan {
  id          Int      @id @default(autoincrement())
  challanNo   Int
  challanDate DateTime
  toFactory   String
  fromFactory String

  // Optional composition link (for AOP/KWO/DWO deliveries)
  yarnCompId  Int?
  composition Composition? @relation(fields: [yarnCompId], references: [id])

  // One challan can have multiple deliveries (different types)
  deliveries deliveries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate challans for the same number + factories
  @@unique([challanNo, toFactory, fromFactory])
  @@index([challanNo])
  @@index([challanDate])
  @@index([toFactory])
  @@index([fromFactory])
}

// ── Updated deliveries model ──
model deliveries {
  id           Int      @id @default(autoincrement())
  challanNo    Int
  deliveryDate DateTime
  deliveryQty  Int
  deliveryType String // "Yarn Delivery", "Knitting Delivery", "Dyeing Delivery", "Sent For Aop", "Received From Aop", etc.
  yarnId       Int
  toFactory    String
  fromFactory  String

  composition Composition? @relation(fields: [yarnCompId], references: [id])
  yarnCompId  Int?

  // ── Link to universal Challan ──
  challan   Challan? @relation(fields: [challanId], references: [id])
  challanId Int? // NULL for legacy/manual entries

  @@index([yarnCompId])
  @@index([deliveryDate])
  @@index([challanNo])
  @@index([yarnId])
  @@index([challanId])
}

model audit {
  id             Int      @id @default(autoincrement())
  auditTitle     String
  auditStartDate DateTime
  auditEndDate   DateTime
  auditDesc      String
  auditType      String   @default("pending")
}

model jobs {
  id         Int         @id @default(autoincrement())
  jobNo      String      @unique
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]
}

model user {
  id             Int            @id @default(autoincrement())
  userName       String?        @default("NULL")
  name           String
  phoneNo        String         @unique
  password       String
  userRole       String
  workingStation String?        @default("NULL")
  refreshTokens  refreshToken[] // <-- ADD THIS LINE to your existing model
}

model refreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
