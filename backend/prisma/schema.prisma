// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id          Int      @id @default(autoincrement())
  factoryName String   @unique
  type        String?
  createdAt   DateTime @default(now())
  jobId       Int?
}

model Yarns {
  id       Int    @id @unique @default(autoincrement())
  yarnType String @unique
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  workOrderNo        String
  workOrderPlaceDate String
  month              String
  styleNo            String
  lotNo              String
  compositions       Composition[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
}

model Composition {
  id           Int       @id @default(autoincrement())
  composition  String
  color        String
  orderQty     Int
  workOrderQty Int
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId  Int
}

model StyleRequirement {
  id           Int                   @id @default(autoincrement())
  salesContact String
  buyerName    String
  jobNo        String
  poNo         String
  styleNo      String                @unique
  processLoss  String
  rows         StyleRequirementRow[]
  sizes        sizes[]
  workOrders   WorkOrder[]
}

model StyleRequirementRow {
  id                 Int              @id @default(autoincrement())
  styleRequirementId Int
  styleRequirement   StyleRequirement @relation(fields: [styleRequirementId], references: [id])
  color              String
  composition        String
  finishDia          String
  orderQty           String
  finishRequiredQty  String
}

model sizeWiseCutting {
  id             Int    @id @default(autoincrement())
  cuttingStyleId Int
  sizeId         Int
  size           sizes  @relation(fields: [sizeId], references: [id])
  cutQty         String
}

model sizes {
  id                 Int               @id @default(autoincrement())
  sizeName           String
  styleId            Int               @default(0)
  createdAt          DateTime
  cuttingStyleId     Int?
  sizeWiseCuttings   sizeWiseCutting[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
}

model deliveries {
  id                 Int      @id @default(autoincrement())
  challanNo          Int?
  yarnReturnReceived String?
  greyReceivedFromYd String?
  yarnDeliveryForYD  String?
  finishYarnReceived String?
  deliveryDate       DateTime
  jobId              Int      @unique
  styleId            Int      @default(0)
}

model audit {
  id             Int      @id @default(autoincrement())
  auditTitle     String
  auditStartDate DateTime
  auditEndDate   DateTime
  auditDesc      String
  auditType      String   @default("pending")
}
