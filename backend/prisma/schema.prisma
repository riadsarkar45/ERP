generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id          Int      @id @default(autoincrement())
  factoryName String   @unique
  type        String?
  createdAt   DateTime @default(now())
}

model Yarns {
  id       Int    @id @unique @default(autoincrement())
  yarnType String @unique
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  workOrderNo        String
  workOrderPlaceDate String
  month              String
  styleNo            String
  lotNo              String
  jobNo              String
  orderType          String
  compositions       Composition[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
  jobs               jobs?             @relation(fields: [jobId], references: [id])
  jobId              Int?
  yarnDyeingJobs     yarnDyeingJobs[]

  @@index([styleRequirementId])
  @@index([styleNo])
  @@index([jobId])
}

model yarnDyeingJobs {
  id             Int              @id @default(autoincrement())
  color          String
  qty            Float
  composition    String
  createdAt      DateTime         @default(now())
  workOrder      WorkOrder?       @relation(fields: [workOrderId], references: [id])
  workOrderId    Int?
  yarnDeliveries yarnDeliveries[]
}

model yarnDeliveries {
  id Int @id @default(autoincrement())

  yarnDyeingJobs   yarnDyeingJobs? @relation(fields: [yarnDyeingJobsId], references: [id])
  yarnDyeingJobsId Int?
}

model Composition {
  id           Int          @id @default(autoincrement())
  composition  String
  unitePrice   Float // ← was Decimal
  color        String
  orderQty     Int
  workOrderQty Int
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  deliveries   deliveries[]
  workOrderId  Int

  @@index([workOrderId])
  @@index([color])
}

model StyleRequirement {
  id           Int                   @id @default(autoincrement())
  salesContact String
  buyerName    String
  jobNo        String
  poNo         String
  styleNo      String                @unique
  processLoss  String
  rows         StyleRequirementRow[]
  sizes        sizes[]
  workOrders   WorkOrder[]
}

model StyleRequirementRow {
  id                 Int              @id @default(autoincrement())
  styleRequirementId Int
  styleRequirement   StyleRequirement @relation(fields: [styleRequirementId], references: [id])
  color              String
  composition        String
  finishDia          String // ← NOW String
  orderQty           Int // ← was String
  finishRequiredQty  Float // ← was String

  @@index([styleRequirementId])
}

model sizeWiseCutting {
  id             Int   @id @default(autoincrement())
  cuttingStyleId Int
  sizeId         Int
  size           sizes @relation(fields: [sizeId], references: [id])
  cutQty         Int // ← was String

  @@index([sizeId])
  @@index([cuttingStyleId])
}

model sizes {
  id                 Int               @id @default(autoincrement())
  sizeName           String
  createdAt          DateTime          @default(now())
  sizeWiseCuttings   sizeWiseCutting[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?

  @@index([styleRequirementId])
}

model deliveries {
  id           Int          @id @default(autoincrement())
  challanNo    Int
  deliveryDate DateTime
  deliveryQty  Int
  deliveryType String
  yarnId       Int
  toFactory    String
  fromFactory  String
  composition  Composition? @relation(fields: [yarnCompId], references: [id])
  yarnCompId   Int?

  @@index([yarnCompId])
  @@index([deliveryDate])
  @@index([challanNo])
  @@index([yarnId])
}

model audit {
  id             Int      @id @default(autoincrement())
  auditTitle     String
  auditStartDate DateTime
  auditEndDate   DateTime
  auditDesc      String
  auditType      String   @default("pending")
}

model jobs {
  id         Int         @id @default(autoincrement())
  jobNo      String      @unique
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]
}
