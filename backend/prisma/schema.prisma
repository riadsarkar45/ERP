// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id          Int         @id @default(autoincrement())
  factoryName String      @unique
  type        String?
  createdAt   DateTime    @default(now())
  jobId       Int?
  workOrders  WorkOrder[]
}

model Yarns {
  id       Int    @id @unique @default(autoincrement())
  yarnType String @unique
}



model WorkOrder {
  id Int @id @default(autoincrement())

  jobNo              String
  workOrderNo        String?
  bookingColor       String?
  composition        String?
  yarnCount          String?
  brandLot           String?
  bookingQty         String?
  ydProcessLoss      String?
  billNo             String?
  remarks            String?
  factory            Factory  @relation(fields: [factoryId], references: [id])
  orderType          String
  createdAt          DateTime @default(now())
  factoryId          Int
  date               DateTime
}

model StyleRequirement {
  id           Int                   @id @default(autoincrement())
  salesContact String
  buyerName    String
  jobNo        String
  poNo         String
  styleNo      String                @unique
  processLoss  String
  rows         StyleRequirementRow[]
  sizes        sizes[]
}

model StyleRequirementRow {
  id                 Int              @id @default(autoincrement())
  styleRequirementId Int
  styleRequirement   StyleRequirement @relation(fields: [styleRequirementId], references: [id])
  color              String
  composition        String
  finishDia          String
  orderQty           String
  finishRequiredQty  String
}

model sizeWiseCutting {
  id             Int    @id @default(autoincrement())
  cuttingStyleId Int
  sizeId         Int
  size           sizes  @relation(fields: [sizeId], references: [id])
  cutQty         String
}

model sizes {
  id                 Int               @id @default(autoincrement())
  sizeName           String
  styleId            Int               @default(0)
  createdAt          DateTime
  cuttingStyleId     Int?
  sizeWiseCuttings   sizeWiseCutting[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
}

model deliveries {
  id                 Int      @id @default(autoincrement())
  challanNo          Int?
  yarnReturnReceived String?
  greyReceivedFromYd String?
  yarnDeliveryForYD  String?
  finishYarnReceived String?
  deliveryDate       DateTime
  jobId              Int      @unique
  styleId            Int      @default(0)
}

model audit {
  id             Int      @id @default(autoincrement())
  auditTitle     String
  auditStartDate DateTime
  auditEndDate   DateTime
  auditDesc      String
  auditType      String   @default("pending")
}

