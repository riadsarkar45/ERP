generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Factory {
  id          Int      @id @default(autoincrement())
  factoryName String   @unique
  type        String?
  createdAt   DateTime @default(now())
}

model Yarns {
  id       Int    @id @unique @default(autoincrement())
  yarnType String @unique
}

model WorkOrder {
  id                 Int               @id @default(autoincrement())
  workOrderNo        String
  workOrderPlaceDate String
  month              String
  styleNo            String
  lotNo              String
  jobNo              String
  orderType          String
  compositions       Composition[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?
  jobs               jobs?             @relation(fields: [jobId], references: [id])
  jobId              Int?
  factoryName        String            @default("NULL")
  yarnCount          String            @default("NULL")
  stichLength        String            @default("NULL")
  machineDia         String            @default("NULL")
  createdBy          Int               @default(1)
  user               user?             @relation("WorkOrderCreatedBy", fields: [createdBy], references: [id])
  isApproved         Boolean           @default(false)

  @@index([yarnCount])
  @@index([machineDia])
  @@index([stichLength])
  @@index([lotNo])
  @@index([styleRequirementId])
  @@index([styleNo])
  @@index([jobId])
}

model YarnColorBooking {
  id            Int         @id @default(autoincrement())
  color         String
  shade         String?
  yarnCount     String?
  machineDia    String?
  lotNo         String?
  qty           Float
  price         Float
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  compositionId Int

  @@index([compositionId])
  @@index([color])
}

model Composition {
  id                    Int                  @id @default(autoincrement())
  composition           String
  unitePrice            Float
  color                 String
  additional            Int                  @default(0)
  orderQty              Int
  workOrderQty          Float
  workOrder             WorkOrder            @relation(fields: [workOrderId], references: [id])
  workOrderId           Int
  deliveries            deliveries[]
  orderType             String               @default("null")
  styleRequirementRow   StyleRequirementRow? @relation(fields: [styleRequirementRowId], references: [id])
  styleRequirementRowId Int?
  challans              Challan[]
  yarnColors            YarnColorBooking[] // <-- Relation added here

  @@index([workOrderId])
  @@index([color])
  @@index([styleRequirementRowId])
}

model StyleRequirement {
  id                   Int                   @id @default(autoincrement())
  salesContact         String
  buyerName            String
  jobNo                String                @unique
  poNo                 String
  styleNo              String
  processLoss          Float
  isReconciliationDone Boolean?              @default(false)
  rows                 StyleRequirementRow[]
  sizes                sizes[]
  workOrders           WorkOrder[]
  createdBy            Int?
  user                 user?                 @relation(fields: [createdBy], references: [id])

  @@index([buyerName])
  @@index([jobNo])
  @@index([poNo])
}

model StyleRequirementRow {
  id                 Int                 @id @default(autoincrement())
  styleRequirementId Int
  styleRequirement   StyleRequirement    @relation(fields: [styleRequirementId], references: [id])
  color              String
  composition        String
  finishDia          String
  orderQty           Int
  finishRequiredQty  Float
  additional         Int                 @default(0)
  compositions       Composition[]
  reconciliation     reconciliationData?

  @@index([styleRequirementId])
  @@index([color])
  @@index([composition])
}

model sizeWiseCutting {
  id             Int   @id @default(autoincrement())
  cuttingStyleId Int
  sizeId         Int
  size           sizes @relation(fields: [sizeId], references: [id])
  cutQty         Int

  @@index([sizeId])
  @@index([cuttingStyleId])
}

model sizes {
  id                 Int               @id @default(autoincrement())
  sizeName           String
  createdAt          DateTime          @default(now())
  sizeWiseCuttings   sizeWiseCutting[]
  styleRequirement   StyleRequirement? @relation(fields: [styleRequirementId], references: [id])
  styleRequirementId Int?

  @@index([styleRequirementId])
}

model Challan {
  id          Int      @id @default(autoincrement())
  challanNo   Int
  challanDate DateTime
  toFactory   String
  fromFactory String

  yarnCompId  Int?
  composition Composition? @relation(fields: [yarnCompId], references: [id])

  deliveries deliveries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challanNo, toFactory, fromFactory])
  @@index([challanNo])
  @@index([challanDate])
  @@index([toFactory])
  @@index([fromFactory])
}

model deliveries {
  id           Int      @id @default(autoincrement())
  challanNo    Int
  deliveryDate DateTime
  deliveryQty  Float
  deliveryType String
  yarnId       Int
  toFactory    String
  fromFactory  String

  composition Composition? @relation(fields: [yarnCompId], references: [id])
  yarnCompId  Int?

  challan   Challan? @relation(fields: [challanId], references: [id])
  challanId Int?
  createdBy Int      @default(1)
  userId    user     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([yarnCompId])
  @@index([createdBy])
  @@index([deliveryDate])
  @@index([challanNo])
  @@index([challanId])
  @@index([yarnId])
  @@index([id])
  @@index([deliveryType])
  @@index([toFactory])
  @@index([fromFactory])
  @@index([createdAt])
}

model audit {
  id             Int      @id @default(autoincrement())
  auditTitle     String
  auditStartDate DateTime
  auditEndDate   DateTime
  auditDesc      String
  auditType      String   @default("pending")
}

model jobs {
  id         Int         @id @default(autoincrement())
  jobNo      String      @unique
  createdAt  DateTime    @default(now())
  workOrders WorkOrder[]
}

model user {
  id                Int                @id @default(autoincrement())
  userName          String?            @default("NULL")
  name              String
  phoneNo           String             @unique
  password          String
  userRole          String
  workingStation    String?            @default("NULL")
  refreshTokens     refreshToken[]
  deliveries        deliveries[]
  workOrders        WorkOrder[]        @relation("WorkOrderCreatedBy")
  styleRequirements StyleRequirement[]
}

model refreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model reconciliationData {
  id                        Int                  @id @default(autoincrement())
  fabricIssueCuttingDept    Int
  cadConsumption            Int
  plannedCuttingQty         Int
  actualCuttingQty          Int
  cuttingToSewingInput      Int
  physicalFound             Int
  sewingInputQty            Int
  sewingOutputQty           Int
  finishInputQty            Int
  finishOutputQty           Int
  packingInputQty           Int
  packingOutputQty          Int
  shippedQty                Int
  plannedLeftOverQty        Int
  physicalFoundLeftOver     Int
  submittedBy               String
  submittedDate             DateTime             @default(now())
  manufacturingUnite        String               @default("NULL")
  sentForEmbellishment      Int                  @default(0)
  receivedFromEmbellishment Int                  @default(0)
  styleRequirementRow       StyleRequirementRow? @relation(fields: [styleRequirementRowId], references: [id])
  styleRequirementRowId     Int?                 @unique
  note                      String?
}

model yarnStock {
  id                 Int    @unique @default(autoincrement())
  supplierName       String
  count              String
  composition        String
  lotNo              String
  physicalBalanceQty Int
  createdBy          Int
}

model ydStock {
  id            Int    @unique @default(autoincrement())
  count         String
  composition   String
  buyer         String
  jobNo         String
  styleNo       String
  color         String
  dyedYarnLot   String
  yarnDyedStock String
}
